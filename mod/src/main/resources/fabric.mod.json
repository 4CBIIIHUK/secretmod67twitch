{
  "schemaVersion": 1,
  "id": "twitchmod",
  "version": "${version}",
  "name": "Minecraft, but by Twitch Rules",
  "description": "Runs a Minecraft world under fictional moderation: 5 minute grace, 4 rules, strikes, 225 events, 32 cutscenes and 5 minutes against the dragon.",
  "authors": [
    "4CBIIIHUK"
  ],
  "contact": {
    "homepage": "https://github.com/4CBIIIHUK/mod-twitch",
    "sources": "https://github.com/4CBIIIHUK/mod-twitch"
  },
  "license": "MIT",
  "icon": "assets/twitchmod/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.twitchmod.TwitchMod"
    ],
    "client": [
      "dev.twitchmod.TwitchModClient"
    ]
  },
  "mixins": [
    "twitchmod.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "fabric-api": "*"
  },
  "suggests": {
    "sodium": "*"
  }
}
